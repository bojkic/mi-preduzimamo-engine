<% if Decidim::Bih::OperatorAuthorization.allowed?(current_user, :operations_read, organization: current_organization) %>
  <div class="grid-x grid-margin-x" id="admin-bih-dashboard-entry" data-admin-dashboard-bih-entry="operations">
    <div class="cell small-12 medium-8 large-6">
      <div class="card" style="border-left:4px solid #c64f2e;">
        <div class="card-section">
          <h2 class="h4" style="margin-top:0;"><%= t("decidim.bih.admin.dashboard.operations_entry.title") %></h2>
          <p><%= t("decidim.bih.admin.dashboard.operations_entry.body") %></p>
          <%= link_to safe_join([
                        icon("dashboard-line", class: "fill-current"),
                        tag.span(t("decidim.bih.admin.dashboard.operations_entry.cta"))
                      ]),
                      decidim_admin_bih.operations_path,
                      class: "button button__sm button__secondary",
                      data: { admin_dashboard_bih_entry_link: "operations" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
