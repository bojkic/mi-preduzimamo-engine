<% add_decidim_page_title(t("decidim.bih.admin.partner_profiles.edit.title", name: @profile.display_name)) %>

<%= render "decidim/bih/admin/shared/navigation",
           current_item: :partner_profiles,
           current_step_label: [@profile.display_name, t("decidim.bih.admin.partner_profiles.edit.step")] %>

<header class="mi-admin-page-header" id="admin-partner-profile-edit">
  <div>
    <h1 class="mi-admin-page-header__title"><%= t("decidim.bih.admin.partner_profiles.edit.title", name: @profile.display_name) %></h1>
    <p class="mi-admin-page-header__intro"><%= t("decidim.bih.admin.partner_profiles.edit.intro") %></p>
  </div>
  <div class="mi-admin-page-header__actions">
    <%= link_to t("decidim.bih.admin.partner_profiles.edit.review"), partner_profile_path(@profile), class: "button button__sm button__transparent-secondary" %>
    <%= link_to t("decidim.bih.admin.partner_profiles.edit.memberships"), memberships_partner_profile_path(@profile), class: "button button__sm button__transparent-secondary" %>
  </div>
</header>

<div class="callout secondary" id="partner-profile-status-boundary">
  <strong><%= t("decidim.bih.admin.partner_profiles.form.status") %>:</strong>
  <span class="mi-admin-status mi-admin-status--neutral"><%= t("decidim.bih.partner_profiles.statuses.#{@profile.verification_status}") %></span>
  <p class="mi-admin-help"><%= t("decidim.bih.admin.partner_profiles.form.status_locked") %></p>
</div>

<%= render "form", profile: @profile %>
