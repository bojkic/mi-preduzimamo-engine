<%#
  Decidim's transactional mail layout, replaced for every mailer that
  declares `layout "decidim/mailer"` (Decidim::ApplicationMailer and the
  Devise mailer): notifications, the welcome message, badges, password and
  confirmation mail, admin invitations. Newsletters use their own layout.

  Why an override rather than a stylesheet tweak: the core layout paints a
  near-black header band (#1a181d) and a second dark band for the
  organisation link, and pulls its CSS from the `decidim_email` webpack
  pack, which premailer-rails must fetch at delivery time — a dependency
  this engine's own mailers avoid on purpose. This layout ships its CSS
  inline, so it renders identically on a generated host and in production.

  Colours come from the organisation's admin palette (Decidim::Organization
  #colors), so the mail matches whichever site sent it; the fallbacks are
  neutral. Every yield the core templates rely on is kept:
  :see_on_website, :note and :unsubscribe.
%>
<%
  palette = (@organization.try(:colors) || {}).to_h.with_indifferent_access
  accent = palette[:primary].presence || "#2f5570"
  ink_link = palette[:tertiary].presence || accent
  root_url = if @custom_url_for_mail_root.present?
               @custom_url_for_mail_root
             elsif @organization
               decidim.root_url(host: @organization.host)
             end
  org_label = @organization ? organization_name(@organization).html_safe : Decidim.application_name
%>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <%= tag :meta, "http-equiv": "Content-Type", content: "text/html; charset=utf-8" %>
    <%= tag :meta, name: "viewport", content: "width=device-width, initial-scale=1" %>
    <%= tag :meta, name: "color-scheme", content: "light" %>
    <%= tag :meta, name: "supported-color-schemes", content: "light" %>
    <style type="text/css">
      body { margin: 0; padding: 0; width: 100% !important; background-color: #f4f5f7; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table { border-spacing: 0; border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
      td { padding: 0; }
      img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; max-width: 100%; height: auto; }
      .mail-body { background-color: #f4f5f7; width: 100%; }
      .mail-wrap { width: 600px; max-width: 600px; margin: 0 auto; }
      .mail-headnote { font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #6b7680; padding: 16px 24px 8px; text-align: right; }
      .mail-headnote a { color: #6b7680; }
      .mail-card { background-color: #ffffff; border-radius: 14px; overflow: hidden; }
      .mail-accent { height: 6px; line-height: 6px; font-size: 6px; background-color: <%= accent %>; }
      .mail-logo { padding: 28px 32px 8px; text-align: center; }
      .mail-logo img { display: inline-block; max-height: 56px; }
      .mail-logo a { font-family: Helvetica, Arial, sans-serif; font-size: 22px; font-weight: bold; color: <%= ink_link %>; text-decoration: none; }
      .mail-content { padding: 20px 32px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 26px; color: #1f2a33; }
      .mail-content p { margin: 0 0 16px; }
      .mail-content ul, .mail-content ol { margin: 0 0 16px; padding-left: 22px; }
      .mail-content li { margin: 0 0 8px; }
      .mail-content a { color: <%= ink_link %>; text-decoration: underline; }
      .mail-content blockquote { margin: 0 0 16px; padding: 12px 16px; border-left: 4px solid <%= accent %>; background-color: #f7f8fa; color: #3b4854; }
      .mail-content .email-greeting { font-size: 18px; font-weight: bold; color: #10212e; }
      .mail-content .email-button, .mail-content .email-button__cta { margin: 20px 0; text-align: left; }
      .mail-content .email-button a, .mail-content .email-button__cta a { display: inline-block; background-color: <%= accent %>; color: #ffffff !important; text-decoration: none; font-weight: bold; font-size: 16px; line-height: 20px; padding: 14px 26px; border-radius: 10px; }
      .mail-content table.button { width: auto; margin: 20px 0; }
      .mail-content table.button.expanded, .mail-content table.button.expand { width: 100%; }
      .mail-content table.button table { width: 100%; }
      .mail-content table.button td { text-align: center; }
      .mail-content table.button table td { background-color: <%= accent %>; border-radius: 10px; }
      .mail-content table.button table td a { display: block; color: #ffffff !important; text-decoration: none; font-weight: bold; font-size: 16px; line-height: 20px; padding: 14px 26px; }
      .mail-footer { padding: 20px 32px 24px; background-color: #f7f8fa; font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; color: #51606b; text-align: center; }
      .mail-footer a { color: <%= ink_link %>; text-decoration: none; font-weight: bold; }
      .mail-footnote { padding: 16px 24px 28px; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #6b7680; text-align: center; }
      .mail-footnote a { color: #51606b; }
      @media only screen and (max-width: 620px) {
        .mail-wrap { width: 100% !important; max-width: 100% !important; }
        .mail-card { border-radius: 0 !important; }
        .mail-logo, .mail-content, .mail-footer { padding-left: 20px !important; padding-right: 20px !important; }
        .mail-content .email-button a, .mail-content .email-button__cta a { display: block !important; text-align: center !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f5f7;">
    <table role="presentation" class="mail-body" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center" valign="top" style="padding: 0 0 8px;">
          <table role="presentation" class="mail-wrap" width="600" cellpadding="0" cellspacing="0" border="0">
            <% if content_for?(:see_on_website) %>
              <tr>
                <td class="mail-headnote"><%= yield(:see_on_website) %></td>
              </tr>
            <% else %>
              <tr><td style="height:24px; line-height:24px; font-size:24px;">&nbsp;</td></tr>
            <% end %>
            <tr>
              <td>
                <table role="presentation" class="mail-card" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="mail-accent">&nbsp;</td>
                  </tr>
                  <tr>
                    <td class="mail-logo">
                      <%= render partial: "layouts/decidim/mailer_logo", locals: { organization: @organization } %>
                    </td>
                  </tr>
                  <tr>
                    <td class="mail-content">
                      <%= yield %>
                    </td>
                  </tr>
                  <tr>
                    <td class="mail-footer">
                      <% if root_url %>
                        <%= link_to org_label, root_url %>
                      <% else %>
                        <%= org_label %>
                      <% end %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="mail-footnote">
                <% if content_for?(:note) %>
                  <div><%= yield(:note) %></div>
                <% end %>
                <% if content_for?(:unsubscribe) %>
                  <div><%= yield(:unsubscribe) %></div>
                <% end %>
                <div><%= t("decidim.newsletter_mailer.newsletter.no_reply_notice") %></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
