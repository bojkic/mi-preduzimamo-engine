# frozen_string_literal: true

# Generated by `bin/rails generate decidim:bih:install`.
# Keep host-specific branding, data providers, and local integration wiring in
# the host app. Reusable BIH behavior belongs in the decidim-bih engine.

Decidim::Bih.public_mount_path = ENV.fetch(
  "DECIDIM_BIH_PUBLIC_MOUNT_PATH",
  "<%= mount_path %>"
)

magic_link_short_value = ENV.fetch(
  "DECIDIM_BIH_MAGIC_LINK_SHORT_PATH_ENABLED",
  "<%= short_magic_links_literal %>"
)
Decidim::Bih.magic_link_short_path_enabled =
  !magic_link_short_value.match?(/\A(false|0|no)\z/i)

# Required before public launch:
#
# Decidim::Bih.map_default_center = [44.0, 18.0]
# Decidim::Bih.map_default_zoom = 12
# Decidim::Bih.geocoder_user_agent = "YourHost/1.0 (example.org; contact@example.org)"
# Decidim::Bih.geocoder_base_url =
#   ENV.fetch("DECIDIM_BIH_GEOCODER_BASE_URL", nil).presence ||
#   ENV.fetch("NOMINATIM_HOST", nil).presence
# Decidim::Bih.geocoder_search_path = ENV.fetch("DECIDIM_BIH_GEOCODER_SEARCH_PATH", "/search")
#
# Decidim::Bih.infobip_sms_sender = ENV.fetch("INFOBIP_SMS_SENDER", nil)
# Decidim::Bih.reporter_mailer_from = ENV.fetch("REPORTER_MAILER_FROM", "notifications@example.org")
# Decidim::Bih.sistem48_mailer_from = ENV.fetch("SISTEM48_FROM", "reports@example.org")
# Decidim::Bih.sistem48_central_intake = ENV.fetch("SISTEM48_CENTRAL_INTAKE", nil)
# Decidim::Bih.sistem48_archive_url = ENV.fetch("SISTEM48_ARCHIVE_URL", nil)
# Decidim::Bih.sistem48_forwarded_via_name = "your host platform"
#
# Decidim::Bih.flagship_process_slug = "your-flagship-process"
# Decidim::Bih.mi_hub_decision_path = "/processes/your-decision-process"
# WHO PAYS for the platform, in your own reviewed words, and WHERE a proposal is
# submitted. The concierge quotes both whole and DECLINES the question when they
# are unset — it never composes a funder credit or guesses a destination. Each
# takes a String, or a callable (the funding one receives `locale:`) when the
# value has to be resolved per turn rather than at boot.
# Decidim::Bih.public_funding_statement = ->(locale:) { I18n.t("your.funding.sentence", locale:) }
# Decidim::Bih.proposal_path = "/processes/your-flagship-process/f/1/proposals"
# Decidim::Bih.campaign_hashtag = "#yourcampaign"
#
# Decidim::Bih.donations_provider = YourHost::Donations
# Decidim::Bih.concierge_resolver = -> { YourHost::ConciergeResponder }
# Verify host provider method contracts with:
#   bundle exec rake decidim_bih:host_contract:providers
#
# Decidim::Bih.goodwill_earning_schedule = {
#   report_created: 10
# }
# Decidim::Bih.goodwill_daily_caps = {
#   comment_created: 5
# }
# Decidim::Bih.goodwill_rewards_catalog = [
#   { key: :community_thanks, cost: 50 }
# ]
#
# Optional public/PWA channel settings:
#
# Decidim::Bih.goodwill_season_started_at = Date.new(2026, 1, 1)
# Decidim::Bih.pwa_short_name = "MI!"
# Decidim::Bih.viber_bot_uri = ENV.fetch("VIBER_BOT_URI", nil)
# Decidim::Bih.viber_public_onboarding_enabled = false
#
# Enable the engine phone gateway only after Infobip credentials and sender
# names are configured for the host. Authentication delivery uses configured
# channels in this order: Viber, WhatsApp AUTH, SMS. Messenger is excluded from
# phone authentication even when a chat sender is configured. WhatsApp also
# requires INFOBIP_WHATSAPP_PHONE_TEMPLATE_NAME. Enable
# INFOBIP_MESSAGES_API_ENABLED only after Infobip Messages API onboarding and
# live failover verification. SMS remains final.
#
# Decidim.sms_gateway_service = "Decidim::Bih::Sms::InfobipGateway"
#
# Phone-first registration. Opt-in; the engine default is stock Decidim. With
# it on, an account is activated without the e-mail confirmation link, the
# phone is the verified identity, and e-mail is confirmed separately so it can
# still reset a password.
#
# Set the cutoff WITH the flag, never after it. It is the instant before which
# an existing confirmed_at counts as a real e-mail confirmation (a Time, or a
# String parsed as UTC). With the flag on and no cutoff nothing is
# grandfathered: every account that confirmed by e-mail before the switch
# loses e-mail password reset until it confirms its address again.
#
# Decidim::Bih.phone_first_registration = true
# Decidim::Bih.phone_first_registration_since = "2026-09-05T00:00:00Z"
