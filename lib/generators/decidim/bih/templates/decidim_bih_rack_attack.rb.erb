Rack::Attack.throttle("bih/chat.feedback/ip", limit: 60, period: 60) do |request|
  request.ip if request.post? && request.path == mounted_path.call("chat/feedback")
end

# The session ID — never the session COOKIE. With the default CookieStore the
# cookie value is AES-GCM ciphertext that is rewritten on nearly every
# authenticated request, so a rule keyed on it gives each request its own
# counter and can never fire. The id behind it is stable, and reading it here
# neither loads nor creates a session (Rails extracts it from the request).
# Anything that is not a real session object (a bare Rack env hash) has no id
# and is treated as "no session".
public_session_id = lambda do |request|
  session = request.session
  session.respond_to?(:id) ? session.id.to_s : nil
end

# Per-session budget for the authenticated surfaces. Per-IP ceilings cannot be
# used there: the launch venue puts hundreds of citizens behind one NAT, and a
# shared egress IP would lock the whole room out of the very step it came to
# do. The session is the closest thing to "one citizen" Rack::Attack can see
# this early in the stack.
#
# Call it ONLY from inside a matching block: reaching for the session on every
# request is work anonymous traffic does not need. The id is digested, so it
# never reaches the Rack::Attack store or its logs, and a request carrying no
# session at all falls back to the IP so the rule still counts something.
public_session_discriminator = lambda do |request|
  id = public_session_id.call(request)
  id.blank? ? "ip:#{request.ip}" : "s:#{Digest::SHA256.hexdigest(id)[0, 32]}"
end

community_projects_path = mounted_path.call("projekti")
community_project_submission_path = %r{\A#{Regexp.escape(community_projects_path)}/prijave/[^/]+\z}
contribution_needs_path = mounted_path.call("volontiranje/potrebe")
contribution_need_cancel_path = %r{\A#{Regexp.escape(contribution_needs_path)}/[^/]+/otkazi\z}
contribution_offer_create_path = %r{\A#{Regexp.escape(contribution_needs_path)}/[^/]+/ponude\z}
contribution_offers_path = mounted_path.call("volontiranje/ponude")
contribution_offer_action_path = %r{\A#{Regexp.escape(contribution_offers_path)}/[^/]+/(?:prihvati|odbij|povuci|isporuceno|potvrdi)\z}
community_contribution_write_path = lambda do |request|
  (request.post? && request.path == community_projects_path) ||
    (request.request_method == "PATCH" && request.path.match?(community_project_submission_path)) ||
    (request.post? && request.path == contribution_needs_path) ||
    (request.post? && request.path.match?(contribution_need_cancel_path)) ||
    (request.post? && request.path.match?(contribution_offer_create_path)) ||
    (request.post? && request.path.match?(contribution_offer_action_path))
end

Rack::Attack.throttle("bih/community-contributions.write/ip", limit: 10, period: 60) do |request|
  request.ip if community_contribution_write_path.call(request)
end

Rack::Attack.throttle("bih/community-contributions.write/session", limit: 60, period: 3600) do |request|
  public_session_discriminator.call(request) if community_contribution_write_path.call(request)
end

organizations_path = mounted_path.call("organizacije")
organization_profile_path = %r{\A#{Regexp.escape(organizations_path)}/[^/]+\z}
organization_action_path = %r{\A#{Regexp.escape(mounted_path.call("organizacija"))}/[^/]+/(?:regrant|potrosnja|obavjestenja|clanovi(?:/[^/]+)?)\z}
membership_action_path = %r{\A#{Regexp.escape(mounted_path.call("organizacija/clanstvo"))}/[^/]+/(?:prihvati|odbij|napusti)\z}
organization_write_path = lambda do |request|
