    (request.request_method == "PATCH" && request.path.match?(organization_profile_path)) ||
    (request.post? && request.path.match?(organization_action_path)) ||
    (%w[PATCH DELETE].include?(request.request_method) && request.path.match?(membership_action_path))
end

Rack::Attack.throttle("bih/organizations.write/ip", limit: 10, period: 60) do |request|
  request.ip if organization_write_path.call(request)
end

Rack::Attack.throttle("bih/organizations.write/session", limit: 30, period: 3600) do |request|
