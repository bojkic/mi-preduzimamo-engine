require "digest"
require "rack/attack"

mount_path = Decidim::Bih.normalized_public_mount_path
mount_prefix = mount_path == "/" ? "" : mount_path
mounted_path = lambda do |suffix|
  "#{mount_prefix}/#{suffix.to_s.delete_prefix("/")}"
end

Rack::Attack.throttle("bih/reports.create/ip", limit: 10, period: 60) do |request|
  request.ip if request.post? && request.path == mounted_path.call("prijave")
end

