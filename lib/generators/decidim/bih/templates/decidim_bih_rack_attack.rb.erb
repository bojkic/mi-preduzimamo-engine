# "Potvrdi e-mail" from Moj nalog. Every request spends a real e-mail to an
# address the platform has NOT yet proven, so the endpoint is a way to point
# the platform's own outbound mail at a stranger's inbox. The controller
# already refuses a second request inside 20 minutes; this bounds how fast a
# session can walk around that by changing the address in between. Per session
# rather than per IP for the same reason as the phone surfaces: the launch
# venue puts the whole room behind one NAT.
email_confirmation_request_path = mounted_path.call("potvrdi-email")
Rack::Attack.throttle("bih/email-confirmation-request/session", limit: 3, period: 900) do |request|
  public_session_discriminator.call(request) if request.post? && request.path == email_confirmation_request_path
end

magic_link_prefixes = [mounted_path.call("v/")]
magic_link_prefixes << "/v/" if Decidim::Bih.magic_link_short_path_enabled
magic_link_prefixes.uniq!

Rack::Attack.throttle("bih/magic-link", limit: 10, period: 60) do |request|
  request.ip if request.post? && magic_link_prefixes.any? { |prefix| request.path.start_with?(prefix) }
end

Rack::Attack.throttle("bih/phone-login/ip", limit: 5, period: 900) do |request|
  request.ip if request.post? && request.path == mounted_path.call("prijava")
end

Rack::Attack.throttle("bih/phone-login-code/ip", limit: 10, period: 60) do |request|
  request.ip if request.post? && request.path == mounted_path.call("prijava/kod")
end

Rack::Attack.throttle("bih/phone-login/phone", limit: 3, period: 900) do |request|
  # Decidim::Bih::Throttling.phone_key normalises and salts: a discriminator
  # becomes a cache key, and a citizen's number has no business sitting in the
  # throttle store — in clear OR as a bare digest a lookup table would undo.
  Decidim::Bih::Throttling.phone_key(request.params["phone"]) if request.post? && request.path == mounted_path.call("prijava")
end

# Phone verification. Every rule here is keyed per SESSION, never per IP: the
# citizen is signed in by this point, and the launch venue shares one egress
# IP across the room. The real controls are server-side anyway — the typed
# code is budgeted per authorization by
# Decidim::Bih::PhoneVerification::AttemptLimiter, and resend is capped both
# by a 60-second cooldown on the authorization row and by a total of five
# messages per authorization (Decidim::Bih::PhoneVerification::ResendBudget)
# — so these only bound how fast one session can hammer the endpoints.
phone_verification_path = mounted_path.call("verifikacija/telefon")

# The one-step registration's pending page does the same four things for the
# same citizen, so it shares these budgets rather than getting its own: a
# second budget would only mean a second set of paid messages and a second set
# of guesses for whoever rotates sessions. The base is wherever THIS host
# serves the form — Decidim::Bih.registration_base_path when it is set (the
# host owns a root path such as "/registracija"), the engine mount otherwise.
# BOTH forms, not one: a host that sets registration_base_path serves the flow
# at that root path, and the engine goes on answering under its own mount as
# well. Rules that covered only the configured base would leave the mounted
# path — the same controller, the same paid messages — unmetered.
# Decidim::Bih.registration_path_for is the one rule for where this host serves
# the flow (the mailer and the controller read the same one); the mounted path
# is added beside it, and collapses into it on a host that configures no base.
registration_bases = [Decidim::Bih.registration_path_for, mounted_path.call("registracija")].uniq
registration_pending_paths = registration_bases.map { |base| "#{base}/potvrda" }

verification_code_paths = ["#{phone_verification_path}/kod"] + registration_pending_paths.map { |path| "#{path}/kod" }
Rack::Attack.throttle("bih/phone-verification-code/session", limit: 10, period: 60) do |request|
  public_session_discriminator.call(request) if request.post? && verification_code_paths.include?(request.path)
end

verification_resend_paths = ["#{phone_verification_path}/ponovo"] + registration_pending_paths.map { |path| "#{path}/ponovo" }
Rack::Attack.throttle("bih/phone-verification-resend/session", limit: 5, period: 900) do |request|
  public_session_discriminator.call(request) if request.post? && verification_resend_paths.include?(request.path)
end

# "Start over" destroys a whole pending registration — the heavier version of
# the same "this number is wrong" move — so it spends the same budget rather
# than a fresh one it could be used to walk around.
verification_change_paths = [phone_verification_path] + registration_pending_paths
registration_start_over_paths = registration_pending_paths.map { |path| "#{path}/pocni-ispocetka" }
Rack::Attack.throttle("bih/phone-verification-change/session", limit: 5, period: 900) do |request|
  changing = (request.request_method == "DELETE" && verification_change_paths.include?(request.path)) ||
             (request.post? && registration_start_over_paths.include?(request.path))
  public_session_discriminator.call(request) if changing
end

# The poll is a read on the signed-in page and a POST on the registration one
# (that variant can sign the waiting browser in, so it must not be a GET), and
# either way the page asks every few seconds while the citizen taps the link on
# their phone — an unbounded endpoint is still an amplifier. Exact paths, with
# the .json and extension-less forms both listed so they share one budget: a
# start_with? here would also swallow anything a later route hangs below
# ".../status".
verification_status_paths = ["#{phone_verification_path}/status", "#{phone_verification_path}/status.json"] +
                            registration_pending_paths.flat_map { |path| ["#{path}/status", "#{path}/status.json"] }
Rack::Attack.throttle("bih/phone-verification-status/session", limit: 30, period: 60) do |request|
  polling = %w[GET POST].include?(request.request_method) && verification_status_paths.include?(request.path)
  public_session_discriminator.call(request) if polling
end

# Sign-up is the front door of phone-first registration: one POST creates a
# usable account and puts the citizen one click away from a paid message. Both
# doors into that room count here — Decidim's own /users and the one-step form.
# /users is a Decidim core route, so it is NOT under the engine mount, and both
# are anonymous, so the session is not available to key on — this one stays per
# IP. The ceiling is therefore set for the worst legitimate case rather than
# the typical one: a launch venue where hundreds of citizens register over one
# NAT in the same hour. A flood under it still buys nothing without a verified
# phone behind each account.
registration_create_paths = ["/users"] + registration_bases
Rack::Attack.throttle("bih/registration-create/ip", limit: 200, period: 900) do |request|
  request.ip if request.post? && registration_create_paths.include?(request.path)
end

# The ceiling above is set for the worst legitimate case and is relaxed further
# by a venue safelist, so it bounds nothing a script does from a handful of
# addresses: each POST spends a real message on whatever number was typed,
# which need not be the typist's. This budget keys on the NUMBER, so neither
# rotating IPs nor the venue relaxation moves it.
Rack::Attack.throttle("bih/registration-create/phone", limit: 5, period: 900) do |request|
  if request.post? && registration_create_paths.include?(request.path)
    user = request.params["user"]
    raw = user["mobile_phone_number"] if user.is_a?(Hash)
    raw = request.params["mobile_phone_number"] if raw.blank?
    Decidim::Bih::Throttling.phone_key(raw)
  end
end

# Decidim's stock SMS verification form. Every submission spends a real
# provider message, so it is metered twice: once per session and, more
# tightly, once per number — the number is the thing that actually costs
# money, and it is the one key a shared venue IP cannot dilute.
sms_authorization_phone = lambda do |request|
  # NESTED FIRST. The real form is a Decidim form object mimicking
  # :mobile_phone, so a browser posts mobile_phone[mobile_phone_number], and
  # Decidim::Form.from_params merges the nested params OVER the flat ones — a
  # request carrying both keys is sent to the nested number. Reading the flat
  # key first would let "mobile_phone_number=<decoy>" spend the real number's
  # budget on someone else's counter. The flat key is still read as the
  # fallback, or the rule silently matches nothing for API-shaped callers.
  # is_a?(Hash) rather than #dig: a crafted "mobile_phone=x" would make dig
  # raise inside the middleware, i.e. hand an attacker a 500 on the very
  # endpoint this rule exists to protect.
  nested = request.params["mobile_phone"]
  raw = nested["mobile_phone_number"] if nested.is_a?(Hash)
  raw = request.params["mobile_phone_number"] if raw.blank?
  # Same key as bih/phone-login/phone, from the same place: normalised (so
  # spacing and punctuation cannot buy another paid message) and salted.
  Decidim::Bih::Throttling.phone_key(raw)
end

Rack::Attack.throttle("bih/sms-authorization-create/session", limit: 5, period: 900) do |request|
  public_session_discriminator.call(request) if request.post? && request.path == "/sms/authorizations"
end

Rack::Attack.throttle("bih/sms-authorization-create/phone", limit: 3, period: 900) do |request|
  sms_authorization_phone.call(request) if request.post? && request.path == "/sms/authorizations"
end
